{
  "name": "orcamento-compartilhado",
  "version": "1.0.0",
  "description": "App de finanças pessoais com orçamento compartilhado, metas conjuntas e divisão de contas",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "start": "tsx src/index.ts",
    "build:frontend": "cd frontend && npm run build"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.7",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15"
  }
}
